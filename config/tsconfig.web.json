{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/preload/api-types.ts",
    "../src/preload/api/**/*",
    "../src/shared/**/*"
  ],
  "exclude": [
    "../**/node_modules",
    "../**/bower_components",
    "../**/jspm_packages",
    "../out",
    "../**/*.test.*",
    "../**/*.spec.*",
    "../**/__tests__/**",
    "../**/__fixtures__/**"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
